# ===============================================
# LifeQuest Core Backend - Environment Configuration
# ===============================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key
JWT_EXPIRES_IN=7d

# Database Connection (Optional)
# If left unset, backend automatically boots embedded PostgreSQL (PGlite)
# For external PostgreSQL (Railway, Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/lifequest

# Embedded PGlite Storage Directory (Used when DATABASE_URL is not set)
PGLITE_DIR=./data/rpg-pglite

# Google Gemini API Key (Optional: for AI Quest Master live LLM generation)
# If unset, AI Quest Master uses intelligent procedural offline synthesis
GEMINI_API_KEY=your_gemini_api_key_here
