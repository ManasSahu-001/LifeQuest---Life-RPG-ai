{
  "name": "life-rpg-backend",
  "version": "1.0.0",
  "description": "Core Backend, PostgreSQL Database, Authentication, and Server-Authoritative RPG Progression Engine for Life RPG",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/db', {recursive:true}); fs.copyFileSync('src/db/schema.sql', 'dist/db/schema.sql');\"",
    "start": "node --max-old-space-size=384 dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx tests/runTests.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
